---
import * as bg from "../content/about/bg.md";
import * as en from "../content/about/en.md";
import { useTranslations, type Lang } from "../i18n/ui";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { Content } = { en, bg }[lang];
---

<Base lang={lang} title={t("about.title")}>
  <article>
    <h1>{t("about.title")}</h1>
    <Content />
    <a href="/cv-nikolai-vuchkov-10.2026-p.pdf" hreflang="en">
      {t("about.cv")}
    </a>
  </article>
</Base>
