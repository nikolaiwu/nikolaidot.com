interface Props {
  name: keyof typeof marks | keyof typeof lines;
  /** Names the icon when it stands alone; without one it's decorative. */
  label?: string;
}

const { name, label } = Astro.props;
const line = name in lines;
const d = line
  ? lines[name as keyof typeof lines]
  : marks[name as keyof typeof marks];
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill={line ? "none" : "currentColor"}
  stroke={line ? "currentColor" : undefined}
  stroke-width={line ? 2 : undefined}
  stroke-linecap={line ? "round" : undefined}
  stroke-linejoin={line ? "round" : undefined}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {label && <title>{label}</title>}
  <path d={d}></path>
</svg>

<style>
  .icon {
    flex: none;
    inline-size: 1em;
    block-size: 1em;
  }
</style>
