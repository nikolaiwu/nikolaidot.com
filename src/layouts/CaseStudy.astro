---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import WorkYear from "../components/WorkYear.astro";
import { useTranslations, type Lang } from "../i18n/ui";
import type { WorkEntry } from "../lib/work";
import Base from "./Base.astro";

interface Props {
  entry: WorkEntry;
  lang: Lang;
  translated: boolean;
}

const { entry, lang, translated } = Astro.props;
const { title, client, role, stack, summary, cover, url } = entry.data;
const { Content } = await render(entry);
const t = useTranslations(lang);
---

<Base lang={lang} title={title} description={summary} translated={translated}>
  <article>
    <header>
      <h1>{title}</h1>
      <p>{summary}</p>
      <dl>
        <dt>{t("work.client")}</dt>
        <dd>{client}</dd>
        <dt>{t("work.role")}</dt>
        <dd>{role}</dd>
        <dt>{t("work.year")}</dt>
        <dd>
          <WorkYear entry={entry} lang={lang} />
        </dd>
        <dt>{t("work.stack")}</dt>
        <dd>
          <ul>
            {stack.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </dd>
      </dl>
      {url && <a href={url}>{t("work.visit")}</a>}
    </header>
    <Image src={cover} alt="" />
    <Content />
    <footer>
      <a href={getRelativeLocaleUrl(lang, "work")}>{t("work.back")}</a>
    </footer>
  </article>
</Base>
